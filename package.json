		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.11",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@zip.js/zip.js": "^2.6.52",
		"mark.js": "^8.11.1",
		"mhtml-to-html": "^2.0.1",
		"number-precision": "^1.6.0",
		"single-filez-core": "^1.0.26"
