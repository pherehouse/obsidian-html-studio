{
	"name": "obsidian-html-studio",
	"version": "2.0.3",
	"description": "Read, view and visually edit HTML files — slide decks, long pages and more.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"html",
		"htm",
		"obsidian",
		"obsidian-plugin"
	],
	"author": "pherehouse",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
